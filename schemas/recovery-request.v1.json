{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SoraClipse/Stellar-Reclaim/blob/main/schemas/recovery-request.v1.json",
  "title": "Stellar Reclaim recovery request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "domain", "network", "transactionHash", "operationIndex", "originalSender", "recipient", "asset", "originalAmount", "requestedAmount", "returnDestination", "nonce", "issuedAt", "expiresAt"],
  "properties": {
    "version": {"const": 1},
    "domain": {"type": "string", "maxLength": 253, "pattern": "^https?://"},
    "network": {"enum": ["testnet", "public"]},
    "transactionHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operationIndex": {"type": "integer", "minimum": 0, "maximum": 99},
    "originalSender": {"type": "string", "pattern": "^[GM][A-Z2-7]+$"},
    "recipient": {"type": "string", "pattern": "^[GM][A-Z2-7]+$"},
    "asset": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"const": "native"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "code", "issuer"], "properties": {"type": {"const": "credit"}, "code": {"type": "string", "pattern": "^[A-Za-z0-9]{1,12}$"}, "issuer": {"type": "string", "pattern": "^G[A-Z2-7]{55}$"}}}
      ]
    },
    "originalAmount": {"type": "string", "pattern": "^[1-9][0-9]*(\\.[0-9]{1,7})?$|^0\\.[0-9]{1,7}$"},
    "requestedAmount": {"type": "string", "pattern": "^[1-9][0-9]*(\\.[0-9]{1,7})?$|^0\\.[0-9]{1,7}$"},
    "returnDestination": {"type": "string", "pattern": "^[GM][A-Z2-7]+$"},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issuedAt": {"type": "integer", "minimum": 0},
    "expiresAt": {"type": "integer", "minimum": 1}
  }
}
